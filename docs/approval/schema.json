{
  "$schema_version": "1.1",
  "note": "契約參考；執行期完整狀態見 document.json（含 actor／actions／logs）。",
  "form_id": "leave_request_v1",
  "title": "請假申請書",
  "document_ref": "./document.json",
  "layout": {
    "style": "a4_from_json",
    "renderer": "json_only",
    "views": ["form", "json"]
  },
  "logging": {
    "on_button": true,
    "fields": ["at", "actor", "action", "opened", "saved", "changes"],
    "diff_style": "github_red_before_green_after"
  },
  "fields": [
    {
      "name": "applicant",
      "display_name": "申請人",
      "type": "text",
      "required": true,
      "storage": "shared"
    },
    {
      "name": "leave_type",
      "display_name": "假別",
      "type": "dropdown",
      "options": ["特休", "事假", "病假", "其他"],
      "required": true,
      "storage": "shared"
    },
    {
      "name": "leave_date",
      "display_name": "起始日",
      "type": "text",
      "required": true,
      "storage": "shared"
    },
    {
      "name": "days",
      "display_name": "天數",
      "type": "number",
      "required": true,
      "storage": "shared"
    },
    {
      "name": "agent",
      "display_name": "代理人",
      "type": "text",
      "required": false,
      "storage": "shared"
    }
  ],
  "system_fields": [
    "doc_no",
    "current_level",
    "submitted_at",
    "completed_at",
    "status"
  ],
  "privacy": {
    "identity_key": "user_id",
    "shared_store": "api_document_json",
    "rule": "畫面不內建文案；所有呈現、選項與操作 log 來自 document JSON／未來 API"
  }
}
