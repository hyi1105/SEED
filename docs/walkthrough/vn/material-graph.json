{
  "meta": {
    "id": "material-graph",
    "title": "料號關聯圖 A→B→C→D",
    "subtitle": "同級獨立表單 · 一對多連結 · 總表看狀態"
  },
  "roles": [
    { "id": "planner", "label": "料號企劃" },
    { "id": "warehouse", "label": "倉庫／備料" },
    { "id": "buyer", "label": "採購" }
  ],
  "linkRules": [
    {
      "id": "material->need",
      "from": "material",
      "to": "need",
      "cardinality": "1:n",
      "label": "料號 A 可掛多個需求 B（生產／定價／備料…）"
    },
    {
      "id": "need->component",
      "from": "need",
      "to": "component",
      "cardinality": "1:n",
      "label": "一個需求 B 可拆多個底料／申請 C"
    },
    {
      "id": "need->purchase",
      "from": "need",
      "to": "purchase",
      "cardinality": "1:n",
      "label": "需求也可直接連到採購 D"
    },
    {
      "id": "component->purchase",
      "from": "component",
      "to": "purchase",
      "cardinality": "n:n",
      "label": "底料 C 可向供應商採購 D（多對多）"
    }
  ],
  "forms": [
    {
      "id": "material",
      "label": "料號主檔",
      "level": "A",
      "title": "A · 料號主檔",
      "titleField": "sku",
      "statusField": "status",
      "doneWhen": ["已就緒", "已完成"],
      "sections": [
        {
          "id": "main",
          "label": "料號本身",
          "fields": [
            {
              "id": "sku",
              "label": "料號",
              "type": "text",
              "placeholder": "例如 SKU-8801",
              "meaning": "A 的身分證。後面所有需求、底料、採購都掛回這個料號。",
              "acl": {
                "requiredFrom": ["planner"],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["planner"]
              }
            },
            {
              "id": "sku_name",
              "label": "品名",
              "type": "text",
              "placeholder": "人看得懂的名字",
              "meaning": "給人找料；編號給系統對帳。",
              "acl": {
                "requiredFrom": ["planner"],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["planner"]
              }
            },
            {
              "id": "goal",
              "label": "目標說明",
              "type": "textarea",
              "placeholder": "為什麼要建這個料號",
              "meaning": "先講清楚目標，才知道要連哪些 B（生產／定價／備料）。",
              "acl": {
                "requiredFrom": [],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["planner"]
              }
            },
            {
              "id": "status",
              "label": "料號狀態",
              "type": "select",
              "options": ["草稿", "規劃中", "已就緒", "停用"],
              "meaning": "A 自己的狀態；不等於底下 B／C／D 都完成，但總表可以一起看。",
              "acl": {
                "requiredFrom": [],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["planner"]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "need",
      "label": "需求／目標單",
      "level": "B",
      "title": "B · 需求／目標單",
      "titleField": "need_title",
      "statusField": "status",
      "doneWhen": ["已完成"],
      "sections": [
        {
          "id": "main",
          "label": "這個需求要做什麼",
          "fields": [
            {
              "id": "need_title",
              "label": "需求名稱",
              "type": "text",
              "placeholder": "例如：備料、定價、生產",
              "meaning": "B 與 A 同級：不是料號裡的分頁，是另一張獨立單。",
              "acl": {
                "requiredFrom": ["planner", "warehouse"],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["planner", "warehouse"]
              }
            },
            {
              "id": "need_type",
              "label": "需求類型",
              "type": "select",
              "options": ["備料", "定價", "生產", "其他"],
              "meaning": "同料號可同時有多張不同類型的 B。",
              "acl": {
                "requiredFrom": ["planner", "warehouse"],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["planner", "warehouse"]
              }
            },
            {
              "id": "need_detail",
              "label": "需求內容",
              "type": "textarea",
              "placeholder": "例如：倉庫要有空間、要有備料預算…",
              "meaning": "把『需要什麼條件』寫清楚，後面才拆得出 C／D。",
              "acl": {
                "requiredFrom": [],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["planner", "warehouse"]
              }
            },
            {
              "id": "space_ok",
              "label": "倉庫空間",
              "type": "select",
              "options": ["未確認", "足夠", "不足"],
              "meaning": "備料類 B 常見條件之一：有沒有位子放。",
              "acl": {
                "requiredFrom": [],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["warehouse"]
              }
            },
            {
              "id": "budget_ok",
              "label": "備料預算",
              "type": "select",
              "options": ["未確認", "已編列", "不足"],
              "meaning": "另一個常見條件：有沒有錢備。",
              "acl": {
                "requiredFrom": [],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["warehouse", "planner"]
              }
            },
            {
              "id": "status",
              "label": "需求狀態",
              "type": "select",
              "options": ["草稿", "進行中", "已完成", "取消"],
              "meaning": "這張 B 自己完不完成；總表用它判斷打勾。",
              "acl": {
                "requiredFrom": [],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["planner", "warehouse"]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "component",
      "label": "底料／申請單",
      "level": "C",
      "title": "C · 底料／申請單",
      "titleField": "comp_name",
      "statusField": "status",
      "doneWhen": ["已完成", "已核准"],
      "sections": [
        {
          "id": "main",
          "label": "底下還需要什麼",
          "fields": [
            {
              "id": "comp_name",
              "label": "品項",
              "type": "text",
              "placeholder": "例如：瓶子、新紙板",
              "meaning": "備料完成前，常再拆出底料或『申請新板』——這是另一張獨立 C。",
              "acl": {
                "requiredFrom": ["warehouse"],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["warehouse"]
              }
            },
            {
              "id": "comp_kind",
              "label": "種類",
              "type": "select",
              "options": ["包材", "原料", "新板申請", "其他"],
              "meaning": "方便分類與後續採購。",
              "acl": {
                "requiredFrom": [],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["warehouse"]
              }
            },
            {
              "id": "qty",
              "label": "數量",
              "type": "text",
              "placeholder": "需要多少",
              "meaning": "給採購與倉庫對帳用。",
              "acl": {
                "requiredFrom": ["warehouse"],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["warehouse"]
              }
            },
            {
              "id": "status",
              "label": "申請狀態",
              "type": "select",
              "options": ["草稿", "申請中", "已核准", "已完成", "駁回"],
              "meaning": "C 的狀態獨立於 B；B 完成不代表每張 C 都好。",
              "acl": {
                "requiredFrom": [],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["warehouse"]
              }
            }
          ]
        }
      ]
    },
    {
      "id": "purchase",
      "label": "採購單",
      "level": "D",
      "title": "D · 採購單",
      "titleField": "vendor",
      "statusField": "status",
      "doneWhen": ["已到貨", "已完成"],
      "sections": [
        {
          "id": "main",
          "label": "向誰買",
          "fields": [
            {
              "id": "vendor",
              "label": "供應商",
              "type": "text",
              "placeholder": "公司名稱",
              "meaning": "倉庫可能向某公司採購——這是 D，可掛在 C 或直接掛在 B。",
              "acl": {
                "requiredFrom": ["buyer"],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["buyer"]
              }
            },
            {
              "id": "po_no",
              "label": "採購單號",
              "type": "text",
              "placeholder": "PO 編號",
              "meaning": "對外對帳用的單號。",
              "acl": {
                "requiredFrom": ["buyer"],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["buyer"]
              }
            },
            {
              "id": "buy_what",
              "label": "採購內容",
              "type": "textarea",
              "placeholder": "買什麼、對應哪張 C",
              "meaning": "說明這張 D 服務哪一條需求／底料。",
              "acl": {
                "requiredFrom": [],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["buyer"]
              }
            },
            {
              "id": "status",
              "label": "採購狀態",
              "type": "select",
              "options": ["草稿", "詢價中", "已下單", "已到貨", "已完成", "取消"],
              "meaning": "D 自己的進度；總表用來打勾。",
              "acl": {
                "requiredFrom": [],
                "read": ["planner", "warehouse", "buyer"],
                "write": ["buyer"]
              }
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "a_ready",
      "form": "material",
      "label": "料號標為已就緒",
      "role": "planner",
      "whenStatus": ["", "草稿", "規劃中"],
      "require": ["sku", "sku_name"],
      "set": { "status": "已就緒" },
      "message": "A 已就緒。請到其他表單建 B，並用「連到…」掛回此料號。"
    },
    {
      "id": "b_done",
      "form": "need",
      "label": "需求標為已完成",
      "role": "warehouse",
      "whenStatus": ["", "草稿", "進行中"],
      "require": ["need_title", "need_type"],
      "set": { "status": "已完成" },
      "message": "這張 B 完成。記得看總表：底下 C／D 可能還沒好。"
    },
    {
      "id": "b_progress",
      "form": "need",
      "label": "需求進行中",
      "role": "planner",
      "whenStatus": ["", "草稿"],
      "require": ["need_title"],
      "set": { "status": "進行中" },
      "message": "B 進行中。"
    },
    {
      "id": "c_done",
      "form": "component",
      "label": "底料／申請完成",
      "role": "warehouse",
      "whenStatus": ["", "草稿", "申請中", "已核准"],
      "require": ["comp_name", "qty"],
      "set": { "status": "已完成" },
      "message": "C 完成。"
    },
    {
      "id": "d_done",
      "form": "purchase",
      "label": "採購到貨完成",
      "role": "buyer",
      "whenStatus": ["", "草稿", "詢價中", "已下單"],
      "require": ["vendor", "po_no"],
      "set": { "status": "已到貨" },
      "message": "D 到貨。可在總表一次核對整圖狀態。"
    }
  ],
  "tables": [
    {
      "id": "forms",
      "label": "四種同級獨立表單",
      "fields": [
        { "label": "A 料號", "origin": "主體存在；不是容器塞 B" },
        { "label": "B 需求", "origin": "生產／定價／備料…各一張，A 可掛很多張" },
        { "label": "C 底料／申請", "origin": "備料底下再拆瓶子、新板…" },
        { "label": "D 採購", "origin": "向某公司買；可掛 C 或 B" }
      ]
    },
    {
      "id": "graph",
      "label": "圖與總表",
      "fields": [
        { "label": "連結", "origin": "多對多；不是表單內嵌子表" },
        { "label": "狀態總表", "origin": "一眼看哪些完成、連到誰" }
      ]
    }
  ],
  "show": {
    "cast": [
      { "id": "narrator", "label": "旁白", "tone": "soft" },
      { "id": "you", "label": "你", "tone": "user" },
      { "id": "guide", "label": "系統顧問", "tone": "guide" },
      { "id": "planner", "label": "料號企劃", "tone": "manager" },
      { "id": "wh", "label": "倉庫", "tone": "hr" },
      { "id": "buyer", "label": "採購", "tone": "guide" }
    ],
    "start": "s01",
    "nodes": {
      "s01": {
        "speaker": "narrator",
        "line": "這個系統有四張表單。開場先看「誰連誰」的虛擬關係圖——先不要出現空白欄位，才不會一開始就跳進沒意義的空格。",
        "showSchema": true,
        "schemaHighlight": ["A", "B", "C", "D"],
        "next": "s02"
      },
      "s02": {
        "speaker": "you",
        "line": "我先有一個料號。它可能要生產、要定價、要備料——這些不該全塞進料號那一張裡吧？",
        "showSchema": true,
        "schemaHighlight": ["A", "B"],
        "schemaRules": ["material->need"],
        "next": "s03"
      },
      "s03": {
        "speaker": "guide",
        "line": "對。A 料號、B 需求、C 底料、D 採購——四張是同級獨立表單。用連結組成圖：A 可掛很多 B，B 再掛 C／D。先記住大圖，下一步才進 A 的欄位。",
        "showSchema": true,
        "schemaHighlight": ["A", "B", "C", "D"],
        "next": "s04"
      },
      "s04": {
        "speaker": "planner",
        "line": "大圖有了。現在才進 A 這一張：先填料號本身——這是身分證字號。",
        "form": "material",
        "doc": "a1",
        "focus": "sku",
        "unlockSection": "main",
        "reveal": ["sku"],
        "fillFromDemo": ["sku"],
        "typewriter": true,
        "next": "s05"
      },
      "s05": {
        "speaker": "planner",
        "line": "品名給人看；目標說明寫為什麼要建它——後面才知道要連哪些 B。",
        "form": "material",
        "doc": "a1",
        "focus": "sku_name",
        "reveal": ["sku_name", "goal", "status"],
        "fillFromDemo": ["sku_name", "goal", "a_status"],
        "mapFill": { "a_status": "status" },
        "typewriter": true,
        "next": "s06"
      },
      "s06": {
        "speaker": "guide",
        "line": "現在開三張獨立的 B，都連回同一張 A：備料、定價、生產。",
        "form": "material",
        "doc": "a1",
        "ensureDocs": [
          { "id": "b_prep", "formId": "need", "title": "備料需求" },
          { "id": "b_price", "formId": "need", "title": "定價需求" },
          { "id": "b_mfg", "formId": "need", "title": "生產需求" }
        ],
        "links": [
          { "from": "a1", "to": "b_prep", "label": "需要備料" },
          { "from": "a1", "to": "b_price", "label": "需要定價" },
          { "from": "a1", "to": "b_mfg", "label": "需要生產" }
        ],
        "next": "s07"
      },
      "s07": {
        "speaker": "wh",
        "line": "先看備料這張 B。它是獨立表單：倉庫空間、備料預算——這些是這張需求的條件，不是寫在料號裡。",
        "form": "need",
        "doc": "b_prep",
        "focus": "need_title",
        "unlockSection": "main",
        "reveal": ["need_title", "need_type", "need_detail", "space_ok", "budget_ok", "status"],
        "fillFromDemo": [
          "b_prep_title",
          "b_prep_type",
          "b_prep_detail",
          "space_ok",
          "budget_ok",
          "b_prep_status"
        ],
        "mapFill": {
          "b_prep_title": "need_title",
          "b_prep_type": "need_type",
          "b_prep_detail": "need_detail",
          "b_prep_status": "status"
        },
        "typewriter": true,
        "next": "s08"
      },
      "s08": {
        "speaker": "planner",
        "line": "定價、生產也各是一張 B——同樣連著 A，但狀態各自走。",
        "form": "need",
        "doc": "b_price",
        "ensureDocs": [
          { "id": "b_price", "formId": "need", "title": "定價需求" },
          { "id": "b_mfg", "formId": "need", "title": "生產需求" }
        ],
        "reveal": ["need_title", "need_type", "need_detail", "status"],
        "fillFromDemo": ["b_price_title", "b_price_type", "b_price_detail", "b_price_status"],
        "mapFill": {
          "b_price_title": "need_title",
          "b_price_type": "need_type",
          "b_price_detail": "need_detail",
          "b_price_status": "status"
        },
        "typewriter": true,
        "next": "s09"
      },
      "s09": {
        "speaker": "guide",
        "line": "備料做下去，常還要底下的東西：瓶子、申請新紙板——那是 C，再從 B 連出去。一張 B 可以掛很多 C。",
        "form": "need",
        "doc": "b_prep",
        "ensureDocs": [
          { "id": "c_bottle", "formId": "component", "title": "瓶子" },
          { "id": "c_board", "formId": "component", "title": "新紙板申請" }
        ],
        "links": [
          { "from": "b_prep", "to": "c_bottle", "label": "需要瓶子" },
          { "from": "b_prep", "to": "c_board", "label": "申請新板" }
        ],
        "next": "s10"
      },
      "s10": {
        "speaker": "wh",
        "line": "這張 C：瓶子。數量、種類寫在自己的單上。",
        "form": "component",
        "doc": "c_bottle",
        "focus": "comp_name",
        "unlockSection": "main",
        "reveal": ["comp_name", "comp_kind", "qty", "status"],
        "fillFromDemo": ["c_bottle_name", "c_bottle_kind", "c_bottle_qty", "c_bottle_status"],
        "mapFill": {
          "c_bottle_name": "comp_name",
          "c_bottle_kind": "comp_kind",
          "c_bottle_qty": "qty",
          "c_bottle_status": "status"
        },
        "typewriter": true,
        "next": "s11"
      },
      "s11": {
        "speaker": "buyer",
        "line": "倉庫要向『明達包材』買瓶子——這是 D。我把採購單連到瓶子這張 C；也可以同時讓備料 B 看得到這條採購。",
        "form": "purchase",
        "doc": "d1",
        "ensureDoc": { "id": "d1", "formId": "purchase", "title": "明達包材" },
        "links": [
          { "from": "c_bottle", "to": "d1", "label": "向供應商採購" },
          { "from": "b_prep", "to": "d1", "label": "備料相關採購" }
        ],
        "focus": "vendor",
        "unlockSection": "main",
        "reveal": ["vendor", "po_no", "buy_what", "status"],
        "fillFromDemo": ["vendor", "po_no", "buy_what", "d_status"],
        "mapFill": { "d_status": "status" },
        "typewriter": true,
        "next": "s12"
      },
      "s12": {
        "speaker": "guide",
        "line": "現在打開總表：每一張獨立單據的狀態、連出連入，一次看完。完成與否打在自己的狀態上。",
        "showBoard": true,
        "boardHighlight": ["a1", "b_prep", "c_bottle", "d1"],
        "next": "s13"
      },
      "s13": {
        "speaker": "guide",
        "line": "你要哪一種結局示範？",
        "showBoard": true,
        "choices": [
          { "id": "all_done", "label": "假設關鍵路徑都完成（總表打勾）", "next": "b_done" },
          { "id": "partial", "label": "備料完成但採購未到貨（狀態不一致）", "next": "b_partial" }
        ]
      },
      "b_done": {
        "speaker": "narrator",
