{
  "id": "leave-show",
  "title": "請假系統",
  "subtitle": "從空舞台長出整套系統 · 視覺小說式導覽",
  "zones": [
    { "id": "apply", "label": "申請端", "hint": "誰填、填什麼" },
    { "id": "process", "label": "處理中段", "hint": "誰審、審什麼" },
    { "id": "close", "label": "結案", "hint": "怎樣算結束" },
    { "id": "acl", "label": "權限", "hint": "誰能動哪些" },
    { "id": "output", "label": "產出物", "hint": "留下什麼紀錄" }
  ],
  "cast": [
    { "id": "narrator", "label": "旁白", "tone": "soft" },
    { "id": "you", "label": "你", "tone": "user" },
    { "id": "guide", "label": "系統顧問", "tone": "guide" },
    { "id": "manager", "label": "主管", "tone": "manager" },
    { "id": "hr", "label": "HR", "tone": "hr" }
  ],
  "start": "s01",
  "nodes": {
    "s01": {
      "speaker": "narrator",
      "line": "舞台是空的。等一下，名稱會一塊一塊長出來。你只要點「下一步」。",
      "next": "s02"
    },
    "s02": {
      "speaker": "guide",
      "line": "我們來蓋一套請假系統。先聽你要什麼——別急著畫資料表。",
      "next": "s03"
    },
    "s03": {
      "speaker": "you",
      "line": "我要請假系統。要有姓名、電話，還有最後一天。",
      "next": "s04"
    },
    "s04": {
      "speaker": "guide",
      "line": "好。申請端先長出三個空白——這是申請人自己填的。",
      "reveal": [
        { "id": "applicant_name", "zone": "apply", "label": "姓名", "purpose": "知道是誰要請假" },
        { "id": "applicant_phone", "zone": "apply", "label": "電話", "purpose": "請假期間聯絡得到人" },
        { "id": "last_day", "zone": "apply", "label": "最後一天", "purpose": "請假要休到哪一天" }
      ],
      "next": "s05"
    },
    "s05": {
      "speaker": "guide",
      "line": "申請人還需要一個動作：送出。送出後，單子才進處理中段。",
      "reveal": [
        { "id": "btn_submit", "zone": "apply", "label": "送出", "purpose": "把請假單交給主管", "kind": "button" }
      ],
      "next": "s06"
    },
    "s06": {
      "speaker": "you",
      "line": "送出之後，要給主管簽。",
      "next": "s07"
    },
    "s07": {
      "speaker": "guide",
      "line": "處理中段長出第一簽核人的空白：誰簽、何時、結果、說了什麼。",
      "reveal": [
        { "id": "m_name", "zone": "process", "label": "一簽姓名", "purpose": "留下是哪位主管處理" },
        { "id": "m_date", "zone": "process", "label": "一簽日期", "purpose": "記錄何時決定" },
        { "id": "m_status", "zone": "process", "label": "一簽狀態", "purpose": "同意或不同意" },
        { "id": "m_comment", "zone": "process", "label": "一簽意見", "purpose": "不同意時要寫原因" }
      ],
      "next": "s08"
    },
    "s08": {
      "speaker": "manager",
      "line": "我看過了。同意就往下；不同意……你等等自己選。",
      "next": "s09"
    },
    "s09": {
      "speaker": "you",
      "line": "同意之後，還要給 HR 處理。",
      "next": "s10"
    },
    "s10": {
      "speaker": "guide",
      "line": "第二簽核人也一樣：姓名、日期、狀態、意見——掛在處理中段。",
      "reveal": [
        { "id": "h_name", "zone": "process", "label": "二簽姓名", "purpose": "HR 是誰處理這張" },
        { "id": "h_date", "zone": "process", "label": "二簽日期", "purpose": "HR 何時處理" },
        { "id": "h_status", "zone": "process", "label": "二簽狀態", "purpose": "HR 是否完成處理" },
        { "id": "h_comment", "zone": "process", "label": "二簽意見", "purpose": "備註或補件說明" }
      ],
      "next": "s11"
    },
    "s11": {
      "speaker": "hr",
      "line": "人事這邊確認假別與天數後，就可以結案了。",
      "next": "s12"
    },
    "s12": {
      "speaker": "guide",
      "line": "結案區長出狀態——整張單的最終結果。",
      "reveal": [
        { "id": "final_status", "zone": "close", "label": "結案狀態", "purpose": "核准／退回／拒絕，一眼看完" }
      ],
      "next": "s13"
    },
    "s13": {
      "speaker": "guide",
      "line": "現在談權限。誰能動申請端？誰能動一簽？",
      "reveal": [
        { "id": "acl_applicant", "zone": "acl", "label": "申請人可寫申請欄", "purpose": "只有本人能改自己的請假內容" },
        { "id": "acl_manager", "zone": "acl", "label": "主管可寫一簽", "purpose": "一簽空白只有主管能動" },
        { "id": "acl_hr", "zone": "acl", "label": "HR 可寫二簽與結案", "purpose": "結案由 HR 收尾" }
      ],
      "next": "s14"
    },
    "s14": {
      "speaker": "guide",
      "line": "關鍵分歧來了——主管若不同意，系統該怎麼走？",
      "choices": [
        {
          "id": "return",
          "label": "退回申請人，讓他改完再送",
          "next": "b_return"
        },
        {
          "id": "reject",
          "label": "直接拒絕結案，不能再改",
          "next": "b_reject"
        }
      ]
    },
    "b_return": {
      "speaker": "guide",
      "line": "你選了退回。申請端多一顆「撤回／退回後可改」的按鈕；結案狀態會變成待修改。",
      "reveal": [
        { "id": "btn_return", "zone": "apply", "label": "退回可改", "purpose": "一簽不同意時退回申請端", "kind": "button" },
        { "id": "status_revise", "zone": "close", "label": "待修改", "purpose": "退回後的結案狀態" }
      ],
      "flags": { "ending": "return" },
      "next": "s15"
    },
    "b_reject": {
      "speaker": "guide",
      "line": "你選了直接拒絕。結案狀態多一個「已拒絕」；申請端不再開放修改。",
      "reveal": [
        { "id": "status_rejected", "zone": "close", "label": "已拒絕", "purpose": "一簽不同意且不給改" }
      ],
      "flags": { "ending": "reject" },
      "next": "s15"
    },
    "s15": {
      "speaker": "guide",
      "line": "最後，產出物——系統至少留下兩張表的紀錄，之後才查得到。",
      "reveal": [
        { "id": "tbl_leave", "zone": "output", "label": "請假主檔", "purpose": "申請內容＋結案狀態", "kind": "table" },
        { "id": "tbl_sign", "zone": "output", "label": "簽核歷程", "purpose": "每一關的人／日／狀態／意見", "kind": "table" }
      ],
      "next": "s16"
    },
    "s16": {
      "speaker": "narrator",
      "line": "拼圖齊了。你現在可以指著舞台說：有哪些名稱、在哪一區、誰能動、用來完成什麼。",
      "next": "end"
    },
    "end": {
      "speaker": "guide",
      "line": "模型走完。下一步去真實畫面／地圖驗證——看欄位怎麼連、流程怎麼跑。",
      "ending": true,
      "summary": true,
      "cta": [
        { "label": "打開地圖驗證", "action": "open-map", "system": "leave" },
        { "label": "再看一次 show", "action": "restart" }
      ]
    }
  },
  "tables": [
    {
      "id": "leave",
      "label": "請假主檔",
      "fields": [
        { "label": "姓名", "origin": "申請人要請假" },
        { "label": "電話", "origin": "請假期間要聯絡" },
        { "label": "最後一天", "origin": "知道休到哪天" },
        { "label": "結案狀態", "origin": "整張單的最終結果" }
      ]
    },
    {
      "id": "sign",
      "label": "簽核歷程",
      "fields": [
        { "label": "關卡（一簽／二簽）", "origin": "主管與 HR 兩關" },
        { "label": "簽核人姓名", "origin": "留下是誰處理" },
        { "label": "日期", "origin": "何時決定" },
        { "label": "狀態", "origin": "同意／不同意／完成" },
        { "label": "意見", "origin": "原因或備註" }
      ]
    }
  ]
}
