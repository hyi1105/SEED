{
  "$schema_version": "1.0",
  "note": "此檔為欄位／權限契約參考；執行期完整申請單狀態請見 document.json（畫面純渲染）。",
  "form_id": "leave_request_v1",
  "title": "請假申請書",
  "document_ref": "./document.json",
  "layout": {
    "style": "a4_from_json",
    "renderer": "json_only",
    "views": ["form", "json"]
  },
  "fields": [
    {
      "name": "applicant",
      "display_name": "申請人",
      "type": "text",
      "required": true,
      "editable_by": ["applicant"],
      "visible_to": ["applicant", "approver", "agent"],
      "storage": "shared"
    },
    {
      "name": "leave_type",
      "display_name": "假別",
      "type": "dropdown",
      "options": ["特休", "事假", "病假", "其他"],
      "required": true,
      "editable_by": ["applicant"],
      "visible_to": ["applicant", "approver", "agent"],
      "storage": "shared"
    },
    {
      "name": "leave_date",
      "display_name": "起始日",
      "type": "text",
      "required": true,
      "editable_by": ["applicant"],
      "visible_to": ["applicant", "approver", "agent"],
      "storage": "shared"
    },
    {
      "name": "days",
      "display_name": "天數",
      "type": "number",
      "required": true,
      "editable_by": ["applicant"],
      "visible_to": ["applicant", "approver", "agent"],
      "storage": "shared"
    },
    {
      "name": "agent",
      "display_name": "代理人",
      "type": "text",
      "required": false,
      "editable_by": ["applicant"],
      "visible_to": ["applicant", "approver", "agent"],
      "storage": "shared"
    }
  ],
  "system_fields": [
    "doc_no",
    "current_level",
    "submitted_at",
    "completed_at",
    "status"
  ],
  "privacy": {
    "identity_key": "user_id",
    "shared_store": "api_document_json",
    "rule": "畫面不內建文案；所有呈現與選項來自 document JSON／未來 API"
  }
}
